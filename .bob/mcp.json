{
  "mcpServers": {
    "agentshield-security-gateway": {
      "command": "python",
      "args": [
        "-m",
        "integrations.ibm_bob_mcp_proxy"
      ],
      "description": "AgentShield Deterministic Security Proxy for IBM Bob MCP tool executions (OWASP LLM08, CWE-362 mitigation)",
      "env": {
        "AGENTSHIELD_GATEWAY_URL": "http://localhost:8888",
        "ENFORCE_INVARIANTS": "true",
        "INVARIANTS": "I1-I11",
        "MAX_TRANSACTION_LIMIT_INR": "50000",
        "MERKLE_AUDIT_ENABLED": "true",
        "TARGET_ECOSYSTEM": "IBM Bob Autonomous SDLC"
      }
    }
  }
}
